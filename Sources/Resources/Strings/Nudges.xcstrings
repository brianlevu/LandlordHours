    "nudge.behind.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %lldh behind the pace for %lld by Dec 31."
          }
        }
      }
    },
    "nudge.behind.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pace"
          }
        }
      }
    },
    "nudge.care.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up next: %@."
          }
        }
      }
    },
    "nudge.outOfReach.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld by Dec 31 is out of reach at this pace. Keep logging what you do."
          }
        }
      }
    },
    "nudge.weekly.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld this year. About %lldh a week gets you to %lld by Dec 31."
          }
        }
      }
    },
    "nudge.weekly.bodyMet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld this year. You’re at your goal."
          }
        }
      }
    },
