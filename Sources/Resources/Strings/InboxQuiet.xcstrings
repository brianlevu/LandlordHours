    "quiet.maybe.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure"
          }
        }
      }
    },
    "quiet.prompt.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You said %lld events from this calendar aren’t rental work."
          }
        }
      },
      "comment": "Why we ask, e.g. You said 3 events from this calendar aren’t rental work."
    },
