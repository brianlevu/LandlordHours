    },
    "quiet.calendars.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the list of calendars"
          }
        }
      }
    },
    "quiet.calendars.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We look for rental work only in the calendars you turn on. Turn off the calendar for your day job to keep its meetings out of your Inbox."
          }
        }
      }
    },
    "quiet.calendars.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        }
      }
    },
    "quiet.calendars.some": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld turned on"
          }
        }
      },
      "comment": "How many calendars the Inbox reads, e.g. 2 of 3 turned on"
    },
    "quiet.calendars.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendars"
          }
        }
      }
    },
