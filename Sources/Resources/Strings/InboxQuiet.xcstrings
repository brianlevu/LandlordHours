    },
    "quiet.maybe.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These aren’t counted in To confirm. We never send an alert for them."
          }
        }
      }
    },
    "quiet.maybe.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the items we aren’t sure about"
          }
        }
      }
    },
