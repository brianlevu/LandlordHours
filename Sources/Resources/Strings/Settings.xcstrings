    "settings.capture.disclosure.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar suggestions and the notes you type or say in Log time are read by Apple’s on-device model, on your iPhone, to fill in the form. Nothing goes to us or anyone else, and nothing is saved until you tap Log."
          }
        }
      }
    },
    "settings.capture.disclosure.pcc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar suggestions use Apple’s on-device model. When you type or say a note in Log time, that model reads it to fill in the form. If it can’t, Apple’s Private Cloud Compute may read it instead (turn that off above). Apple runs Private Cloud Compute, and it doesn’t keep your note. Nothing goes to us or anyone else, and nothing is saved until you tap Log."
          }
        }
      }
    },
