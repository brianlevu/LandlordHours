+    /// `duoUnfold` on the real shell: one window per pose, the clock held at each instant (the motion and
+    /// a still at any t are the same thing, `DoorPose`).
+    private static func runDoor(scene: UIWindowScene, dir: URL) async {
+        let L = UIContentSizeCategory.large, XXL = UIContentSizeCategory.extraExtraLarge
+        let openInsets = UIEdgeInsets(top: 24, left: 0, bottom: 20, right: 0)
+        let proppedInsets = UIEdgeInsets(top: 24, left: 0, bottom: 34, right: 0)
+        let poses: [(String, CGSize, UIContentSizeCategory, String, UIEdgeInsets)] = [
+            ("door-open-3rentals", duoOpen, L, "3", openInsets),
+            ("door-open-3rentals-XXL", duoOpen, XXL, "3", openInsets),
+            ("door-open-allrentals", duoOpen, L, "0", openInsets),
+            ("door-propped", duoPropped, L, "3", proppedInsets),
+            ("door-propped-XXL", duoPropped, XXL, "3", proppedInsets),
+        ]
+        let steps: [(Double, UnfoldStyle, String)] = UnfoldCapture.swingSteps.map { ($0, .swing, "swing") }
+            + UnfoldCapture.crossfadeSteps.map { ($0, .crossfade, "rm") }
+        for dark in [false, true] {
+            let tag = dark ? "dark" : "light"
+            for (name, size, category, select, insets) in poses {
+                let clock = UnfoldClock()
+                AdaptiveDebug.captureClock = clock
+                duoShot = size
+                duoShotTopInset = insets.top
+                AdaptiveSnapshotSelection.args = ["select": select]
+                let w = makeWindow(size: size, dark: dark, category: category, insets: insets, scene: scene)
+                for _ in 0..<3 {
+                    try? await Task.sleep(for: .seconds(0.4))
+                    settleInsets(w, target: insets)
+                }
+                try? await Task.sleep(for: .seconds(2.0))
+                for (t, style, kind) in steps {
+                    clock.hold(t: t, style: style)
+                    try? await Task.sleep(for: .milliseconds(250))
+                    let file = String(format: "%@-%@-%@-t%03d.png", name, tag, kind, Int((t * 100).rounded()))
+                    snap(w, size: size, scale: 3, to: dir.appendingPathComponent(file))
+                }
+                w.isHidden = true
+                windows.removeAll { $0 === w }
+                duoShot = nil
+                duoShotTopInset = nil
+                AdaptiveDebug.captureClock = nil
+            }
+        }
+    }
+
